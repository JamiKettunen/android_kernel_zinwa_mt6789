&i2c6 {
	flashlightgpio:flashlightgpio@63 {
		compatible = "mediatek,flashlightgpio";
		reg = <0x63>;
		#cooling-cells = <2>;
		pinctrl-names = "default", "enable_high", "enable_low", "mode_high", "mode_low";
		pinctrl-0 = <&flashlightgpio_pins_default>;
		pinctrl-1 = <&flashlightgpio_pins_enable_high>;
		pinctrl-2 = <&flashlightgpio_pins_enable_low>;
		pinctrl-3 = <&flashlightgpio_pins_mode_high>;
		pinctrl-4 = <&flashlightgpio_pins_mode_low>;
		status = "okay";
		flash@0{
			reg = <0>;
			type = <0>;
			ct = <0>;
			part = <0>;
			port@0 {
				fl_core_0: endpoint {
					remote-endpoint = <&flashlight_0>;
				};
			};
		};
		flash@1{
			reg = <1>;
			type = <0>;
			ct = <1>;
			part = <0>;
			port@1 {
				fl_core_1: endpoint {
					remote-endpoint = <&flashlight_1>;
				};
			};
		};
	};
};

&pio {
	flashlightgpio_pins_default: default {
	};

	flashlightgpio_pins_enable_high: enable_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO155__FUNC_GPIO155>;
			slew-rate = <1>;
			output-high;
		};
	};

	flashlightgpio_pins_enable_low: enable_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO155__FUNC_GPIO155>;
			slew-rate = <1>;
			output-low;
		};
	};

	flashlightgpio_pins_mode_high: mode_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO154__FUNC_GPIO154>;
			slew-rate = <1>;
			output-high;
		};
	};

	flashlightgpio_pins_mode_low: mode_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO154__FUNC_GPIO154>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&mtk_composite_v4l2_1 {
	port@0 {
		flashlight_0: endpoint {
			remote-endpoint = <&fl_core_0>;
		};
	};
	port@1 {
		flashlight_1: endpoint {
			remote-endpoint = <&fl_core_1>;
		};
	};
};

/* CAMERA AF */
&i2c8 {
	camera_main_af_mtk:camera_main_af@72 {
		compatible = "mediatek,camera_main_af";
		reg = <0x72>;
		status = "okay";
	};
};

&i2c2 {
	camera_main_two_af_mtk:camera_main_two_af@0d {
		compatible = "mediatek,camera_main_two_af";
		reg = <0x0d>;
		status = "okay";
	};

	camera_main_three_af_mtk:camera_main_three_af@0c {
		compatible = "mediatek,camera_main_three_af";
		reg = <0x0c>;
		status = "okay";
	};
};

&camera_af_hw_node {
	camaf_m1_pmic-supply = <&wl2868c_ldo6>;
	camaf_m2_pmic-supply = <&wl2868c_ldo5>;
	camaf_m3_pmic-supply = <&wl2868c_ldo5>;
	status = "okay";
};
/* CAMERA AF end */
