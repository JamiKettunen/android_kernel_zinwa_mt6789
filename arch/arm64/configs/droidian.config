# halium.config
##################################################
# Halium modifications

# Halium errors
CONFIG_VT=y
# CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_EPOLL=y
CONFIG_PROC_FS=y
# CONFIG_DUMMY=n
CONFIG_INOTIFY_USER=y
CONFIG_RD_GZIP=y
CONFIG_TIMERFD=y
# CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SIGNALFD=y
CONFIG_QUOTACTL=y
CONFIG_SYSVIPC=y
CONFIG_DEVTMPFS=y
# CONFIG_FHANDLE=y
CONFIG_NLS_UTF8=y
CONFIG_SYSFS=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
# CONFIG_COMPAT_VDSO=n
# CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# Halium warnings
# CONFIG_WATCHDOG_NOWAYOUT=n # Enable once there is dsme or an alternative
CONFIG_NET_NS=y
CONFIG_PID_NS=y
# CONFIG_UDF_FS=y
# CONFIG_NETFILTER_XT_MATCH_SCTP=y
CONFIG_NETFILTER_XT_CONNMARK=y
# CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
# CONFIG_NETFILTER_XT_MATCH_DCCP=y
# CONFIG_NETFILTER_XT_MATCH_NFACCT=y
CONFIG_UTS_NS=y
# CONFIG_TMPFS_XATTR=y
CONFIG_BLK_CGROUP=y
# CONFIG_FANOTIFY=y
# CONFIG_CGROUP_PERF=y
CONFIG_CPUSETS=y
# CONFIG_CGROUP_DEVICE=y
CONFIG_IPC_NS=y
CONFIG_MEMCG_KMEM=y

# Other changes for recent kernels
CONFIG_LTO_CLANG_FULL=n
CONFIG_LTO_CLANG_THIN=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_NULL_TTY=y
CONFIG_ARM64_BTI=n



# droidian.config
##################################################
# Droidian requirements
CONFIG_USER_NS=y

# Squashfs
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y

# Waydroid
# CONFIG_NET_CLS_CGROUP=y
# CONFIG_CGROUP_NET_CLASSID=y
CONFIG_VETH=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
# CONFIG_ANDROID_BINDERFS=n
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"

# RNDIS usb networking
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Bluetooth
CONFIG_BT_HCIVHCI=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y

# Crypto
# CONFIG_CRYPTO_USER_API_SKCIPHER=y

# Security
# CONFIG_SECURITY_YAMA=y
CONFIG_INIT_STACK_ALL_ZERO=y

# GKI specific
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure cgroup.memory=nokmem selinux=0 droidian.lvm.prefer console=tty0"



# container.config
##################################################
# Docker stuff by g7
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_VXLAN=y
CONFIG_BRIDGE_VLAN_FILTERING=y
# Additional configs
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CPU_FREQ=y
CONFIG_CFS_SCHED=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_MEM_RES_CTLR=y
CONFIG_CGROUP_MEM_RES_CTLR_SWAP=y
CONFIG_CGROUP_MEM_RES_CTLR_KMEM=y
# CFS_BANDWIDTH seems to be incompatible with SCHED_WALT
# Is not essential to get docker working
# CONFIG_CFS_BANDWIDTH is not set



# disabled-above extras that are ok
##################################################
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_FHANDLE=y
CONFIG_UDF_FS=y
CONFIG_NETFILTER_XT_MATCH_SCTP=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_DCCP=y
CONFIG_TMPFS_XATTR=y
CONFIG_ARM64_BTI=y



# GKI ABI-breaking but fine for us
##################################################
CONFIG_NETFILTER_XT_MATCH_NFACCT=y
CONFIG_FANOTIFY=y
CONFIG_NF_TABLES=y
CONFIG_HUGETLBFS=y



# own extras
##################################################
# custom on-device offline recovery with kmscon+keyd on initramfs
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure cgroup.memory=nokmem selinux=0 console=tty0 halium.recovery"
# bluez networking
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
# systemd-tmpfiles support parsing conditionalized execute bit for mutable system.journal
CONFIG_TMPFS_POSIX_ACL=y
# run desktop environments without hwcomposer
CONFIG_DRM_LINDROID_EVDI=y
